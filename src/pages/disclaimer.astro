---
import Base from '../layouts/Base.astro';
---

<Base
  title="Disclaimer — Andrew Morrison"
  description="The views expressed on this website are solely those of the author in a personal capacity."
>
  <div class="content-container animate-in">
    <header class="page-header">
      <span class="section-label">Disclaimer</span>
      <h1>Personal views only</h1>
      <div class="divider"></div>
    </header>

    <div class="prose">
      <p>
        The views expressed on this website are solely those of the author in a personal
        capacity and do not represent the views or positions of any current or former employer,
        affiliated organisation, or professional body.
      </p>

      <p>
        This site is maintained independently for the purposes of personal reflection, idea
        development, and the sharing of lived experience.
      </p>
    </div>
  </div>
</Base>

<style>
.page-header { padding: 4rem 0 1rem; }
.page-header h1 { margin: 0.75rem 0; }
.prose { padding-bottom: 6rem; }
</style>
