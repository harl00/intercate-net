---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const statusOrder = { active: 0, paused: 1, complete: 2 };
const recentProjects = allProjects
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    if (statusOrder[a.data.status] !== statusOrder[b.data.status])
      return statusOrder[a.data.status] - statusOrder[b.data.status];
    return (b.data.updatedDate ?? b.data.pubDate).valueOf() -
           (a.data.updatedDate ?? a.data.pubDate).valueOf();
  })
  .slice(0, 3);

const statusLabel = { active: 'active', paused: 'paused', complete: 'complete' };
const fmt = (d: Date) => d.toLocaleDateString('en-AU', { year: 'numeric', month: 'short', day: 'numeric' });

const streams = [
  { tag: 'ai-government', label: 'ai + government', desc: 'Public-sector AI, agentic systems, and the policy frameworks that surround them.' },
  { tag: 'technology', label: 'building things', desc: 'Open source, self-hosted infrastructure, and step-by-step guides for beginners.' },
  { tag: 'university', label: 'university', desc: 'Postgraduate study in technology management, teaching, and the occasional essay.' },
];
---

<Base title="intercate · interact, communicate, educate">
  <div class="home-grid" aria-hidden="true"></div>
  <div class="home container">
    <!-- HERO -->
    <header class="hero">
      <p class="eyebrow animate-in delay-1">intercate.net</p>
      <h1 class="wordmark animate-in delay-2"><span class="wm-i">inter</span>cate</h1>
      <p class="tagline animate-in delay-3">interact&ensp;·&ensp;communicate&ensp;·&ensp;educate</p>
      <div class="hero-rule animate-in delay-3"><span></span></div>
      <p class="lede animate-in delay-4">
        A place for thinking out loud about artificial intelligence, government, and
        the craft of building things that work in the public interest.
      </p>
      <p class="byline animate-in delay-4">words by Andrew Morrison</p>
      <div class="actions animate-in delay-4">
        <a href="/blog" class="btn">Read the writing</a>
        <a href="/about" class="btn ghost">What this is</a>
      </div>
    </header>

    <!-- CONNECTIVE INDEX -->
    <section class="band">
      <p class="section-label">what connects here</p>
      <ul class="index">
        {streams.map((s) => (
          <li>
            <a href={`/blog?tag=${s.tag}`} class="index-row">
              <span class="index-label">{s.label}</span>
              <span class="index-line"></span>
              <span class="index-desc">{s.desc}</span>
              <span class="index-go">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- SELECTED PROJECTS -->
    <section class="band">
      <div class="band-head">
        <p class="section-label">selected projects</p>
        <a href="/projects" class="see-all">all projects ↗</a>
      </div>
      <ul class="rows">
        {recentProjects.map((p) => (
          <li>
            <a href={`/projects/${p.id}`} class="row">
              <span class={`meta status-${p.data.status}`}>{statusLabel[p.data.status]}</span>
              <span class="row-body">
                <span class="row-title">{p.data.title}</span>
                <span class="row-desc">{p.data.description}</span>
              </span>
              <span class="index-go">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- RECENT WRITING -->
    <section class="band">
      <div class="band-head">
        <p class="section-label">recent writing</p>
        <a href="/blog" class="see-all">all posts ↗</a>
      </div>
      <ul class="rows">
        {recentPosts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="row">
              <span class="meta">{fmt(post.data.pubDate)}</span>
              <span class="row-body">
                <span class="row-title">{post.data.title}</span>
                <span class="row-desc">{post.data.description}</span>
              </span>
              <span class="index-go">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  /* faint interface lattice behind the hero — the "inter" world */
  .home-grid {
    position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background-image:
      linear-gradient(to right, var(--border-subtle) 1px, transparent 1px),
      linear-gradient(to bottom, var(--border-subtle) 1px, transparent 1px);
    background-size: 72px 72px;
    -webkit-mask-image: radial-gradient(ellipse 80% 55% at 50% 0%, #000 0%, transparent 72%);
    mask-image: radial-gradient(ellipse 80% 55% at 50% 0%, #000 0%, transparent 72%);
    opacity: 0.6;
  }

  /* ── hero ── */
  .hero { padding: clamp(3.5rem, 10vw, 7rem) 0 clamp(2.5rem, 5vw, 4rem); }
  .eyebrow { font-family: var(--font-display); font-weight: 500; font-size: 0.82rem;
    color: var(--text-muted); letter-spacing: 0.02em; margin-bottom: 1.4rem; }
  .wordmark { font-family: var(--font-display); font-weight: 700;
    font-size: clamp(3.2rem, 14vw, 8.5rem); line-height: 0.9; letter-spacing: -0.045em;
    color: var(--text-primary); }
  .wm-i { color: var(--accent); }
  .tagline { font-family: var(--font-display); font-weight: 500;
    font-size: clamp(0.95rem, 2.4vw, 1.15rem); color: var(--text-secondary);
    letter-spacing: 0.01em; margin-top: 1.5rem; }
  .hero-rule { position: relative; height: 1px; background: var(--border);
    margin: 2.2rem 0; max-width: 640px; }
  .hero-rule span { position: absolute; left: 0; top: 50%; width: 9px; height: 9px;
    transform: translateY(-50%); background: var(--accent); border-radius: 50%; }
  .lede { font-family: var(--font-body); font-size: clamp(1.15rem, 2.6vw, 1.5rem);
    line-height: 1.5; color: var(--text-secondary); max-width: 30ch; font-weight: 400; }
  @media (min-width: 640px) { .lede { max-width: 44ch; } }
  .byline { font-family: var(--font-body); font-style: italic; font-size: 0.98rem;
    color: var(--text-muted); margin-top: 1.1rem; }
  .actions { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 2.2rem; }
  .btn { font-family: var(--font-display); font-weight: 500; font-size: 0.9rem;
    letter-spacing: 0.005em; padding: 0.7rem 1.3rem; border-radius: var(--radius);
    background: var(--accent); color: #fff; border: 1px solid var(--accent);
    transition: background var(--transition), transform var(--transition); }
  .btn:hover { background: var(--accent-hover); transform: translateY(-1px); color: #fff; }
  .btn.ghost { background: transparent; color: var(--text-secondary); border-color: var(--border); }
  .btn.ghost:hover { color: var(--text-primary); border-color: var(--text-muted); background: transparent; }

  /* ── bands ── */
  .band { padding: clamp(2.5rem, 5vw, 3.5rem) 0; border-top: 1px solid var(--border-subtle); }
  .band .section-label { margin-bottom: 1.6rem; }
  .band-head { display: flex; justify-content: space-between; align-items: baseline;
    gap: 1rem; margin-bottom: 1.6rem; }
  .band-head .section-label { margin-bottom: 0; }
  .see-all { font-family: var(--font-display); font-weight: 500; font-size: 0.82rem;
    color: var(--text-muted); transition: color var(--transition); white-space: nowrap; }
  .see-all:hover { color: var(--accent); }

  /* ── connective index (signature) ── */
  .index, .rows { list-style: none; }
  .index-row { display: flex; align-items: baseline; gap: 1rem; padding: 1.15rem 0;
    border-bottom: 1px solid var(--border-subtle); transition: border-color 200ms; }
  .index li:first-child .index-row { border-top: 1px solid var(--border-subtle); }
  .index-label { font-family: var(--font-display); font-weight: 500; font-size: 1rem;
    color: var(--text-primary); min-width: 11rem; flex-shrink: 0; letter-spacing: -0.005em;
    transition: color 200ms; }
  .index-line { flex: 1; height: 1px; background: var(--border); align-self: center;
    transition: background 200ms; }
  .index-desc { font-family: var(--font-body); font-size: 1rem; color: var(--text-secondary);
    max-width: 42ch; text-align: right; }
  .index-go { font-family: var(--font-display); color: var(--text-muted); font-size: 0.95rem;
    opacity: 0; transform: translateX(-4px); transition: opacity 200ms, transform 200ms, color 200ms; }
  .index-row:hover { border-color: var(--accent); }
  .index-row:hover .index-label { color: var(--accent); }
  .index-row:hover .index-line { background: var(--accent); }
  .index-row:hover .index-go { opacity: 1; transform: translateX(0); color: var(--accent); }
  @media (max-width: 680px) {
    .index-row { flex-wrap: wrap; gap: 0.5rem; }
    .index-line { display: none; }
    .index-desc { text-align: left; max-width: none; }
  }

  /* ── list rows ── */
  .row { display: grid; grid-template-columns: 8.5rem 1fr auto; gap: 1.2rem;
    align-items: baseline; padding: 1.3rem 0; border-bottom: 1px solid var(--border-subtle);
    transition: border-color 200ms; }
  .rows li:first-child .row { border-top: 1px solid var(--border-subtle); }
  .meta { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);
    letter-spacing: 0.01em; padding-top: 0.2rem; }
  .status-active { color: var(--accent); }
  .row-body { display: grid; gap: 0.35rem; }
  .row-title { font-family: var(--font-display); font-weight: 600; font-size: 1.15rem;
    line-height: 1.25; color: var(--text-primary); letter-spacing: -0.015em; transition: color 200ms; }
  .row-desc { font-family: var(--font-body); font-size: 1rem; color: var(--text-secondary);
    line-height: 1.55; max-width: 64ch; }
  .row:hover { border-color: var(--accent); }
  .row:hover .row-title { color: var(--accent); }
  .row:hover .index-go { opacity: 1; transform: translateX(0); color: var(--accent); }
  @media (max-width: 680px) {
    .row { grid-template-columns: 1fr; gap: 0.5rem; }
    .row .index-go { display: none; }
  }
</style>
