---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const relatedPosts = (await getCollection('blog', ({ data }) =>
  !data.draft && data.project === entry.id
)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const statusLabel = { active: 'Active', paused: 'Paused', complete: 'Complete' };

const typeLabel: Record<string, string> = {
  pdf: 'PDF', doc: 'Document', dataset: 'Dataset',
  colab: 'Colab', github: 'GitHub', link: 'Link',
};

const typeIcon: Record<string, string> = {
  pdf: '↓',
  doc: '↓',
  dataset: '⊞',
  colab: '▶',
  github: '⌥',
  link: '↗',
};

const updated = entry.data.updatedDate ?? entry.data.pubDate;
---

<Base
  title={`${entry.data.title} — Andrew Morrison`}
  description={entry.data.description}
>
  <div class="content-container animate-in">
    <header class="project-header">
      <div class="project-header-meta">
        <a href="/projects" class="back-link">← Projects</a>
        <span class={`project-status ${entry.data.status}`}>
          {statusLabel[entry.data.status]}
        </span>
      </div>
      <h1>{entry.data.title}</h1>
      <p class="project-desc">{entry.data.description}</p>
      <div class="project-dates">
        <span>Started {entry.data.pubDate.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
        {entry.data.updatedDate && (
          <span class="updated-sep">·</span>
          <span>Updated {entry.data.updatedDate.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
        )}
      </div>
      {entry.data.tags.length > 0 && (
        <div class="project-tags">
          {entry.data.tags.map(tag => (
            <span class={`tag tag-${tag}`}>{tag.replace('-', ' ')}</span>
          ))}
        </div>
      )}
      <div class="divider"></div>
    </header>

    <div class="prose project-prose">
      <Content />
    </div>

    {entry.data.resources.length > 0 && (
      <section class="resources-section">
        <h2 class="section-heading">Resources</h2>
        <div class="resources-list">
          {entry.data.resources.map(resource => {
            const isExternal = !resource.url.startsWith('/');
            return (
              <a
                href={resource.url}
                class="resource-card"
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
              >
                <span class="resource-type">{typeLabel[resource.type]}</span>
                <span class="resource-label">{resource.label}</span>
                <span class="resource-icon">{typeIcon[resource.type]}</span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {relatedPosts.length > 0 && (
      <section class="related-section">
        <h2 class="section-heading">Related writing</h2>
        <div class="related-list">
          {relatedPosts.map(post => (
            <a href={`/blog/${post.id}`} class="related-post">
              <div class="related-post-meta">
                {post.data.tags.map(tag => (
                  <span class={`tag tag-${tag}`}>{tag.replace('-', ' ')}</span>
                ))}
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' })}
                </time>
              </div>
              <span class="related-post-title">{post.data.title}</span>
            </a>
          ))}
        </div>
      </section>
    )}

  </div>
</Base>

<style>
.project-header { padding: 4rem 0 2rem; }

.project-header-meta {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.25rem;
}

.back-link {
  font-size: 0.82rem;
  color: var(--text-muted);
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.back-link:hover { color: var(--accent); }

.project-header h1 { margin-bottom: 0.75rem; }

.project-desc {
  font-size: 1.1rem;
  color: var(--text-secondary);
  line-height: 1.6;
  max-width: 54ch;
  margin-bottom: 0.75rem;
}

.project-dates {
  font-size: 0.82rem;
  color: var(--text-muted);
  display: flex;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
}

.project-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.5rem; }

.project-prose { padding-bottom: 3rem; }

.section-heading {
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-muted);
  font-family: var(--font-body);
  margin-bottom: 1rem;
}

.resources-section { padding: 2.5rem 0; border-top: 1px solid var(--border-subtle); }
.resources-list { display: grid; gap: 0.5rem; }

.resource-card {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.9rem 1.25rem;
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius);
  text-decoration: none;
  transition: border-color var(--transition), background var(--transition);
}
.resource-card:hover {
  border-color: var(--accent);
  background: var(--bg-elevated);
}

.resource-type {
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-muted);
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  padding: 0.15em 0.5em;
  border-radius: 2px;
  flex-shrink: 0;
}

.resource-label {
  font-size: 0.92rem;
  color: var(--text-primary);
  flex: 1;
}

.resource-icon {
  font-size: 0.9rem;
  color: var(--text-muted);
  flex-shrink: 0;
}

.related-section { padding: 2.5rem 0 6rem; border-top: 1px solid var(--border-subtle); }
.related-list { display: grid; gap: 0.5rem; }

.related-post {
  display: grid;
  gap: 0.4rem;
  padding: 1rem 1.25rem;
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius);
  text-decoration: none;
  transition: border-color var(--transition), background var(--transition);
}
.related-post:hover { border-color: var(--accent); background: var(--bg-elevated); }

.related-post-meta {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}
.related-post-meta time {
  font-size: 0.78rem;
  color: var(--text-muted);
}

.related-post-title {
  font-size: 0.95rem;
  color: var(--text-primary);
  font-family: var(--font-display);
  line-height: 1.3;
}

.project-status {
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 0.2em 0.6em;
  border-radius: 2px;
}
.project-status.active {
  background: var(--accent-dim);
  color: var(--accent);
  border: 1px solid var(--accent-border);
}
.project-status.paused {
  background: var(--bg-elevated);
  color: var(--text-muted);
  border: 1px solid var(--border);
}
.project-status.complete {
  background: rgba(74, 124, 111, 0.15);
  color: #4a7c6f;
  border: 1px solid rgba(74, 124, 111, 0.3);
}
</style>
