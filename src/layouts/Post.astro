---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  ogImage?: string;
  linkedinSnippet?: string;
}

const { title, description, pubDate, updatedDate, tags, ogImage, linkedinSnippet } = Astro.props;

const dateFormatted = pubDate.toLocaleDateString('en-AU', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const linkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`;

// slop-meter: paste your deployed Worker URL here to enable the "is this AI slop?"
// rating widget on every post. Leave empty to hide it. See /slop-meter/README.md.
const SLOP_ENDPOINT = 'https://slop.intercate.net';
---

<Base title={title} description={description} ogImage={ogImage} article={true} pubDate={pubDate}>
  <article class="animate-in">
    <header class="post-header content-container">
      <div class="post-header-meta">
        <div class="tags-row">
          {tags.map(tag => (
            <a href={`/blog?tag=${tag}`} class={`tag tag-${tag}`}>
              {tag.replace('-', ' ')}
            </a>
          ))}
        </div>
        <time datetime={pubDate.toISOString()} class="post-date">{dateFormatted}</time>
        {updatedDate && (
          <span class="updated-date">
            Updated {updatedDate.toLocaleDateString('en-AU', { year: 'numeric', month: 'long', day: 'numeric' })}
          </span>
        )}
      </div>

      <h1>{title}</h1>
      <p class="post-desc">{description}</p>

      <div class="post-actions">
        <a
          href={linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="linkedin-share"
          aria-label="Share on LinkedIn"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          Share on LinkedIn
        </a>
        <a href="/blog" class="back-link">← All writing</a>
      </div>

      <div class="divider"></div>
    </header>

    <div class="prose content-container">
      <slot />
    </div>

    <div class="post-footer content-container">
      <div class="divider"></div>
      <p class="disclaimer">This post reflects my personal views, not those of any employer.</p>

      <div class="post-footer-share">
        <p>Found this useful?</p>
        <a
          href={linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="linkedin-share"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          Share on LinkedIn
        </a>
        <button class="copy-link-btn" id="copy-link-btn" aria-label="Copy link to post">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
          </svg>
          <span id="copy-link-label">Copy link</span>
        </button>
      </div>
    </div>

    {SLOP_ENDPOINT && (
      <section class="slop-section content-container">
        <h2 class="comments-heading">Reader signal</h2>
        <slop-meter post-id={Astro.url.pathname} endpoint={SLOP_ENDPOINT}></slop-meter>
        <script is:inline type="module" src="/slop-meter.js"></script>
      </section>
    )}

    <section class="comments-section content-container">
      <h2 class="comments-heading">Discussion</h2>
      <div id="giscus-container"></div>
    </section>
  </article>
</Base>

<script is:inline>
  // Load Giscus with correct initial theme
  (function () {
    var theme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark_dimmed' : 'light';
    var script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.dataset.repo = 'harl00/intercate-net';
    script.dataset.repoId = 'R_kgDOSr5DEA';
    script.dataset.category = 'General';
    script.dataset.categoryId = 'DIC_kwDOSr5DEM4C-MhH';
    script.dataset.mapping = 'pathname';
    script.dataset.strict = '0';
    script.dataset.reactionsEnabled = '1';
    script.dataset.emitMetadata = '0';
    script.dataset.inputPosition = 'top';
    script.dataset.theme = theme;
    script.dataset.lang = 'en';
    script.crossOrigin = 'anonymous';
    script.async = true;
    document.getElementById('giscus-container').appendChild(script);
  })();

  // Copy link button
  (function () {
    var btn = document.getElementById('copy-link-btn');
    var label = document.getElementById('copy-link-label');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var url = location.href;
      if (navigator.share) {
        navigator.share({ title: document.title, url: url });
      } else {
        navigator.clipboard.writeText(url).then(function () {
          label.textContent = 'Copied!';
          setTimeout(function () { label.textContent = 'Copy link'; }, 2000);
        }).catch(function () {
          label.textContent = 'Copy failed';
          setTimeout(function () { label.textContent = 'Copy link'; }, 2000);
        });
      }
    });
  })();
</script>

<style>
.post-header {
  padding-top: 4rem;
  padding-bottom: 2rem;
}

.post-header-meta {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 1.5rem;
}

.tags-row { display: flex; gap: 0.5rem; flex-wrap: wrap; }

.post-date {
  font-size: 0.82rem;
  color: var(--text-muted);
  letter-spacing: 0.02em;
}

.updated-date {
  font-size: 0.82rem;
  color: var(--text-muted);
  font-style: italic;
}

h1 { margin-bottom: 1rem; }

.post-desc {
  font-size: 1.15rem;
  color: var(--text-secondary);
  line-height: 1.6;
  max-width: 58ch;
  margin-bottom: 1.5rem;
}

.post-actions {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  flex-wrap: wrap;
}

.back-link {
  font-size: 0.85rem;
  color: var(--text-muted);
}
.back-link:hover { color: var(--text-secondary); }

.post-footer {
  padding-top: 2rem;
  padding-bottom: 3rem;
}

.disclaimer {
  font-size: 0.82rem;
  color: var(--text-muted);
  font-style: italic;
  margin-bottom: 1.5rem;
}

.post-footer-share {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.post-footer-share p {
  color: var(--text-muted);
  font-size: 0.9rem;
  margin: 0;
}

.copy-link-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: none;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text-muted);
  font-size: 0.82rem;
  font-weight: 500;
  padding: 0.5rem 1rem;
  cursor: pointer;
  transition: border-color var(--transition), color var(--transition);
}
.copy-link-btn:hover {
  border-color: var(--text-muted);
  color: var(--text-secondary);
}

.prose {
  padding-top: 2rem;
  padding-bottom: 2rem;
}

.slop-section {
  padding-top: 1rem;
  padding-bottom: 2rem;
}
/* Custom properties pierce the shadow DOM, so the widget adopts the site theme. */
.slop-section slop-meter {
  --slop-border: var(--border);
  --slop-surface: var(--bg-surface);
  --slop-text: var(--text-primary);
  --slop-muted: var(--text-muted);
}

.comments-section {
  padding-bottom: 6rem;
  border-top: 1px solid var(--border-subtle);
  padding-top: 3rem;
}

.comments-heading {
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-muted);
  font-family: var(--font-body);
  margin-bottom: 1.5rem;
}
</style>
