---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  article?: boolean;
  pubDate?: Date;
}

const {
  title,
  description = 'intercate.net. Interact, communicate, educate. Writing on artificial intelligence, government, and the craft of building in the public interest. Words by Andrew Morrison.',
  ogImage = '/og-default.png',
  article = false,
  pubDate,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Primary Meta -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Andrew Morrison" />

  <!-- Open Graph — critical for LinkedIn previews -->
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="intercate.net" />
  {article && pubDate && (
    <meta property="article:published_time" content={pubDate.toISOString()} />
  )}

  <!-- Twitter/X Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <!-- LinkedIn specific — profile author link -->
  <meta property="article:author" content="https://www.linkedin.com/in/andrewnmorrison/" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- RSS -->
  <link rel="alternate" type="application/rss+xml" title="intercate.net" href="/rss.xml" />

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- Microsoft Clarity -->
  <script is:inline type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "wz1akjdbbt");
  </script>

  <!-- Apply saved theme before first paint to avoid flash -->
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <nav>
    <div class="nav-inner">
      <a href="/" class="nav-brand"><span class="brand-i">inter</span>cate</a>
      <ul class="nav-links">
        <li><a href="/blog" class={currentPath.startsWith('/blog') ? 'active' : ''}>Writing</a></li>
        <li><a href="/projects" class={currentPath.startsWith('/projects') ? 'active' : ''}>Projects</a></li>
        <li><a href="/work" class={currentPath.startsWith('/work') ? 'active' : ''}>Work</a></li>
        <li><a href="/about" class={currentPath === '/about' ? 'active' : ''}>About</a></li>
      </ul>
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle light/dark mode">
        <!-- sun shown in light mode (default), moon in dark mode -->
        <svg id="icon-moon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="display:none"><path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"/></svg>
        <svg id="icon-sun" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 18a6 6 0 1 1 0-12 6 6 0 0 1 0 12zm0-2a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM11 1h2v3h-2V1zm0 19h2v3h-2v-3zM3.515 4.929l1.414-1.414L7.05 5.636 5.636 7.05 3.515 4.93zM16.95 18.364l1.414-1.414 2.121 2.121-1.414 1.414-2.121-2.121zm2.121-14.85l1.414 1.415-2.121 2.121-1.414-1.414 2.121-2.121zM5.636 16.95l1.414 1.414-2.121 2.121-1.414-1.414 2.121-2.121zM23 11v2h-3v-2h3zM4 11v2H1v-2h3z"/></svg>
      </button>
    </div>
  </nav>

  <script is:inline>
    (function () {
      var btn = document.getElementById('theme-toggle');
      var moon = document.getElementById('icon-moon');
      var sun = document.getElementById('icon-sun');
      var html = document.documentElement;

      function apply(theme) {
        if (theme === 'dark') {
          html.setAttribute('data-theme', 'dark');
          moon.style.display = '';
          sun.style.display = 'none';
        } else {
          html.removeAttribute('data-theme');
          moon.style.display = 'none';
          sun.style.display = '';
        }
      }

      try {
        apply(localStorage.getItem('theme') || 'light');
      } catch (e) {
        apply('light');
      }

      btn.addEventListener('click', function () {
        var next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem('theme', next); } catch (e) {}
        apply(next);
        var giscusFrame = document.querySelector('iframe.giscus-frame');
        if (giscusFrame) {
          giscusFrame.contentWindow.postMessage(
            { giscus: { setConfig: { theme: next === 'dark' ? 'dark_dimmed' : 'light' } } },
            'https://giscus.app'
          );
        }
      });
    })();
  </script>

  <main>
    <slot />
  </main>

  <footer>
    <div class="footer-inner">
      <p class="footer-disclaimer">
        The views expressed on this website are solely those of the author in a personal
        capacity and do not represent the views or positions of any current or former employer,
        affiliated organisation, or professional body. This site is maintained independently
        for the purposes of personal reflection, idea development, and the sharing of lived
        experience. <a href="/disclaimer">Read the full disclaimer</a>.
      </p>
      <div class="footer-meta">
        <span><span class="brand-i">inter</span>cate.net · words by Andrew Morrison · © {new Date().getFullYear()}</span>
        <div class="footer-links">
          <a href="https://www.linkedin.com/in/andrewnmorrison/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="/rss.xml">RSS</a>
          <a href="/about">About</a>
          <a href="/disclaimer">Disclaimer</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Copy button for code blocks in article prose -->
  <script is:inline>
    (function () {
      function addCopyButtons() {
        var blocks = document.querySelectorAll('.prose pre');
        for (var i = 0; i < blocks.length; i++) {
          (function (pre) {
            if (pre.parentElement && pre.parentElement.classList.contains('code-wrap')) return;
            var code = pre.querySelector('code');
            if (!code) return;

            var wrap = document.createElement('div');
            wrap.className = 'code-wrap';
            pre.parentNode.insertBefore(wrap, pre);
            wrap.appendChild(pre);

            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'copy-code-btn';
            btn.setAttribute('aria-label', 'Copy code to clipboard');
            btn.textContent = 'Copy';
            wrap.appendChild(btn);

            btn.addEventListener('click', function () {
              var text = code.textContent || '';
              function done(ok) {
                btn.textContent = ok ? 'Copied' : 'Failed';
                if (ok) btn.classList.add('copied');
                setTimeout(function () {
                  btn.textContent = 'Copy';
                  btn.classList.remove('copied');
                }, 1800);
              }
              if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(function () { done(true); }, function () { done(false); });
              } else {
                try {
                  var ta = document.createElement('textarea');
                  ta.value = text;
                  ta.style.position = 'fixed';
                  ta.style.opacity = '0';
                  document.body.appendChild(ta);
                  ta.select();
                  document.execCommand('copy');
                  document.body.removeChild(ta);
                  done(true);
                } catch (e) { done(false); }
              }
            });
          })(blocks[i]);
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', addCopyButtons);
      } else {
        addCopyButtons();
      }
    })();
  </script>
</body>
</html>
